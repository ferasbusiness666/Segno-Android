<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pad_x"
    android:paddingEnd="@dimen/pad_x">

    <TextView
        android:id="@+id/songsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Segno.Small" />

    <TextView
        android:id="@+id/songsShuffle"
        style="@style/Widget.Segno.Pill.Secondary"
        android:layout_width="wrap_content"
        android:drawableStart="@drawable/ic_shuffle_small"
        android:text="@string/shuffle_play" />
</LinearLayout>
