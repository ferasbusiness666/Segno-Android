<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/s6"
    android:paddingEnd="@dimen/s6"
    android:paddingBottom="@dimen/s3">

    <FrameLayout
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:elevation="8dp">

        <io.github.ferasbusiness666.segno.ui.common.ArtView
            android:id="@+id/headArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:artRadius="@dimen/r_lg" />

        <ImageView
            android:id="@+id/headIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@color/text" />
    </FrameLayout>

    <TextView
        android:id="@+id/headKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s4"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Segno.SmallStrong"
        android:textColor="@color/text_2" />

    <TextView
        android:id="@+id/headTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Segno.H1"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/headSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Segno.Small" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/headPlay"
            style="@style/Widget.Segno.Pill.Primary"
            android:layout_width="wrap_content"
            android:drawableStart="@drawable/ic_play_small"
            android:paddingStart="20dp"
            android:paddingEnd="22dp"
            android:text="@string/play_all" />

        <TextView
            android:id="@+id/headShuffle"
            style="@style/Widget.Segno.Pill.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/s2"
            android:drawableStart="@drawable/ic_shuffle_small"
            android:text="@string/shuffle_play" />

        <ImageButton
            android:id="@+id/headDownload"
            style="@style/Widget.Segno.IconButton"
            android:layout_marginStart="@dimen/s1"
            android:contentDescription="@string/download_all"
            android:src="@drawable/ic_download" />

        <ImageButton
            android:id="@+id/headMore"
            style="@style/Widget.Segno.IconButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
