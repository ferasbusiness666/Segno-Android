<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_h"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pad_x"
    android:paddingEnd="@dimen/s1">

    <io.github.ferasbusiness666.segno.ui.common.ArtView
        android:id="@+id/art"
        android:layout_width="@dimen/row_art"
        android:layout_height="@dimen/row_art"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Widget.Segno.Line.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sub"
            style="@style/Widget.Segno.Line.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/drag"
        android:layout_width="40dp"
        android:layout_height="@dimen/touch"
        android:contentDescription="@string/queue_drag"
        android:padding="10dp"
        android:src="@drawable/ic_grip"
        android:visibility="gone"
        app:tint="@color/text_3" />

    <ImageButton
        android:id="@+id/more"
        style="@style/Widget.Segno.IconButton"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more" />
</LinearLayout>
