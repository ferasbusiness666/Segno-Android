<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing's lyrics, in place of the cover. A row for the fixes at the top (never under a
     line, so it's always free to press), the lines below, and a note while looking. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lyricsList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/touch"
        android:fadingEdgeLength="56dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/lyricsBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <TextView
            android:id="@+id/lyricsNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/s2"
            android:paddingEnd="@dimen/s2"
            android:text="@string/lyrics_not_timed"
            android:textAppearance="@style/TextAppearance.Segno.Small" />

        <TextView
            android:id="@+id/lyricsEarlier"
            style="@style/Widget.Segno.Pill.Ghost.Small"
            android:layout_width="wrap_content"
            android:contentDescription="@string/lyrics_earlier_desc"
            android:text="@string/lyrics_earlier" />

        <TextView
            android:id="@+id/lyricsNudge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Segno.SmallStrong"
            android:textColor="@color/text_2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lyricsLater"
            style="@style/Widget.Segno.Pill.Ghost.Small"
            android:layout_width="wrap_content"
            android:contentDescription="@string/lyrics_later_desc"
            android:text="@string/lyrics_later" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lyricsWrong"
            style="@style/Widget.Segno.Pill.Ghost.Small"
            android:layout_width="wrap_content"
            android:text="@string/lyrics_wrong" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyricsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/s4"
        android:paddingEnd="@dimen/s4">

        <ProgressBar
            android:id="@+id/lyricsSpinner"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="@dimen/s3"
            android:indeterminateTint="@color/text_2" />

        <TextView
            android:id="@+id/lyricsStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Segno.H2" />

        <TextView
            android:id="@+id/lyricsStatusBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s1"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Segno.Small" />

        <TextView
            android:id="@+id/lyricsRetry"
            style="@style/Widget.Segno.Pill.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/s4"
            android:text="@string/try_again" />
    </LinearLayout>
</FrameLayout>
