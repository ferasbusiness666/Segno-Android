<?xml version="1.0" encoding="utf-8"?>
<!-- Home's shortcuts: a 2 × 2 grid, so four fit side by side even on a 360 dp phone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/s3"
    android:paddingTop="@dimen/s3"
    android:paddingEnd="@dimen/s3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tileSongs"
            style="@style/Widget.Segno.TileRow"
            android:drawableStart="@drawable/tile_songs"
            android:text="@string/home_songs" />

        <TextView
            android:id="@+id/tileLoved"
            style="@style/Widget.Segno.TileRow"
            android:drawableStart="@drawable/tile_loved"
            android:text="@string/home_loved" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tileDownloads"
            style="@style/Widget.Segno.TileRow"
            android:drawableStart="@drawable/tile_downloads"
            android:text="@string/home_downloads" />

        <TextView
            android:id="@+id/tileImport"
            style="@style/Widget.Segno.TileRow"
            android:drawableStart="@drawable/tile_import"
            android:text="@string/home_import" />
    </LinearLayout>
</LinearLayout>
