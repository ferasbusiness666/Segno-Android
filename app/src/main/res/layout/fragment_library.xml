<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pad_x"
        android:paddingEnd="@dimen/s1">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lib_title"
            android:textAppearance="@style/TextAppearance.Segno.H1"
            android:textSize="24sp" />

        <ImageButton
            android:id="@+id/newPlaylist"
            style="@style/Widget.Segno.IconButton"
            android:contentDescription="@string/new_playlist"
            android:src="@drawable/ic_plus" />

        <ImageButton
            android:id="@+id/settings"
            style="@style/Widget.Segno.IconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/pad_x"
            android:paddingTop="@dimen/s1"
            android:paddingEnd="@dimen/pad_x"
            android:paddingBottom="@dimen/s2">

            <TextView
                android:id="@+id/chipPlaylists"
                style="@style/Widget.Segno.Chip"
                android:text="@string/lib_playlists" />

            <TextView
                android:id="@+id/chipSongs"
                style="@style/Widget.Segno.Chip"
                android:layout_marginStart="@dimen/s2"
                android:text="@string/lib_songs" />

            <TextView
                android:id="@+id/chipAlbums"
                style="@style/Widget.Segno.Chip"
                android:layout_marginStart="@dimen/s2"
                android:text="@string/lib_albums" />

            <TextView
                android:id="@+id/chipArtists"
                style="@style/Widget.Segno.Chip"
                android:layout_marginStart="@dimen/s2"
                android:text="@string/lib_artists" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/s6"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty" />
    </FrameLayout>
</LinearLayout>
