<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a new version is out. Its notes, then Later and Update (or the download progress). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/pad_x"
    android:layout_marginTop="@dimen/s2"
    android:layout_marginEnd="@dimen/pad_x"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/s4"
    android:paddingTop="@dimen/s3"
    android:paddingEnd="@dimen/s3"
    android:paddingBottom="@dimen/s3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_update"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/updateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/s3"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Segno.BodyStrong" />
    </LinearLayout>

    <TextView
        android:id="@+id/updateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:ellipsize="end"
        android:maxLines="5"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Segno.Body"
        android:textColor="@color/text_2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Segno.Body"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s3"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateClose"
            style="@style/Widget.Segno.Pill.Ghost"
            android:layout_width="wrap_content"
            android:text="@string/update_dismiss" />

        <TextView
            android:id="@+id/updateGet"
            style="@style/Widget.Segno.Pill.Primary"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/s2"
            android:text="@string/update_get" />
    </LinearLayout>
</LinearLayout>
