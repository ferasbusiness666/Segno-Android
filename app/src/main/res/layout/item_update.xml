<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/pad_x"
    android:layout_marginTop="@dimen/s2"
    android:layout_marginEnd="@dimen/pad_x"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/s4"
    android:paddingTop="@dimen/s2"
    android:paddingEnd="@dimen/s1"
    android:paddingBottom="@dimen/s2">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_update"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/updateText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s3"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Segno.Body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/updateGet"
        style="@style/Widget.Segno.Pill.Primary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/s2"
        android:text="@string/update_get" />

    <ImageButton
        android:id="@+id/updateClose"
        style="@style/Widget.Segno.IconButton"
        android:contentDescription="@string/update_dismiss"
        android:padding="14dp"
        android:src="@drawable/ic_close" />
</LinearLayout>
