<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/s2"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/s4">

    <ImageView
        android:id="@+id/tipIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_raised"
        android:backgroundTint="@color/raised_2"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tipTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Segno.BodyStrong" />

        <TextView
            android:id="@+id/tipBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Segno.Small" />
    </LinearLayout>
</LinearLayout>
