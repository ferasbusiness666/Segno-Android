<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="288dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="@dimen/s3">

    <TextView
        android:id="@+id/sleepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/s1"
        android:paddingEnd="@dimen/s1"
        android:text="@string/sleep_title"
        android:textAppearance="@style/TextAppearance.Segno.BodyStrong" />

    <TextView
        android:id="@+id/sleepSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="@dimen/s1"
        android:paddingEnd="@dimen/s1"
        android:text="@string/sleep_sub"
        android:textAppearance="@style/TextAppearance.Segno.Small" />

    <TextView
        android:id="@+id/sleepClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:paddingStart="@dimen/s1"
        android:paddingEnd="@dimen/s1"
        android:textAppearance="@style/TextAppearance.Segno.H1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sleepRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s3"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep15"
            style="@style/Widget.Segno.SleepChip"
            android:text="@string/sleep_15" />

        <TextView
            android:id="@+id/sleep30"
            style="@style/Widget.Segno.SleepChip"
            android:layout_marginStart="@dimen/s2"
            android:text="@string/sleep_30" />

        <TextView
            android:id="@+id/sleep45"
            style="@style/Widget.Segno.SleepChip"
            android:layout_marginStart="@dimen/s2"
            android:text="@string/sleep_45" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sleepRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep60"
            style="@style/Widget.Segno.SleepChip"
            android:text="@string/sleep_60" />

        <TextView
            android:id="@+id/sleepEnd"
            style="@style/Widget.Segno.SleepChip"
            android:layout_marginStart="@dimen/s2"
            android:layout_weight="2"
            android:text="@string/sleep_end_of_song" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sleepActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s3"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/sleepPlus"
            style="@style/Widget.Segno.SleepChip"
            android:text="@string/sleep_plus10" />

        <TextView
            android:id="@+id/sleepOff"
            style="@style/Widget.Segno.SleepChip"
            android:layout_marginStart="@dimen/s2"
            android:background="@drawable/bg_chip_quiet"
            android:text="@string/sleep_turn_off"
            android:textColor="@color/text_2" />
    </LinearLayout>
</LinearLayout>
