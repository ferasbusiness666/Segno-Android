<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pad_x"
    android:paddingTop="@dimen/s3"
    android:paddingEnd="@dimen/s2">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Segno.H2" />

    <TextView
        android:id="@+id/sectionAction"
        style="@style/Widget.Segno.Pill.Ghost"
        android:layout_width="wrap_content"
        android:visibility="gone" />
</LinearLayout>
