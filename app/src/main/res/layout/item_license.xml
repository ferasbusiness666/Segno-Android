<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingStart="@dimen/pad_x"
    android:paddingEnd="@dimen/s1">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/s2"
        android:paddingBottom="@dimen/s2">

        <TextView
            android:id="@+id/licName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Segno.BodyStrong"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/licSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Segno.Small" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/licLink"
        style="@style/Widget.Segno.IconButton"
        android:contentDescription="@string/set_source"
        android:src="@drawable/ic_external" />
</LinearLayout>
