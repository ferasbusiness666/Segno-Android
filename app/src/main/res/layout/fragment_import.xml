<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/s1"
        android:paddingEnd="@dimen/s1">

        <ImageButton
            android:id="@+id/back"
            style="@style/Widget.Segno.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/s8">

        <LinearLayout
            android:id="@+id/column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/pad_x"
            android:paddingEnd="@dimen/pad_x">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_title"
                android:textAppearance="@style/TextAppearance.Segno.H1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s1"
                android:text="@string/import_sub"
                android:textAppearance="@style/TextAppearance.Segno.Body"
                android:textColor="@color/text_2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s5"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/s4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_paste_title"
                    android:textAppearance="@style/TextAppearance.Segno.BodyStrong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/import_paste_sub"
                    android:textAppearance="@style/TextAppearance.Segno.Small" />

                <EditText
                    android:id="@+id/paste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s3"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:hint="@string/import_paste_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textUri|textNoSuggestions"
                    android:maxLines="8"
                    android:minLines="4"
                    android:padding="@dimen/s3"
                    android:scrollbars="vertical"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Segno.Body"
                    android:textColorHint="@color/text_3"
                    android:textCursorDrawable="@drawable/cursor"
                    android:textDirection="ltr"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/find"
                        style="@style/Widget.Segno.Pill.Primary"
                        android:layout_width="wrap_content"
                        android:drawableStart="@drawable/ic_search_small"
                        android:text="@string/import_find" />

                    <TextView
                        android:id="@+id/pasteButton"
                        style="@style/Widget.Segno.Pill.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/s2"
                        android:text="@string/import_paste" />

                    <TextView
                        android:id="@+id/clear"
                        style="@style/Widget.Segno.Pill.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/s1"
                        android:text="@string/clear" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/s4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_where"
                    android:textAppearance="@style/TextAppearance.Segno.BodyStrong" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s3"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/helpSpotify"
                        style="@style/Widget.Segno.Chip"
                        android:text="Spotify"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/helpYouTube"
                        style="@style/Widget.Segno.Chip"
                        android:layout_marginStart="@dimen/s2"
                        android:text="YouTube"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/helpMusic"
                        style="@style/Widget.Segno.Chip"
                        android:layout_marginStart="@dimen/s2"
                        android:text="YT Music"
                        tools:ignore="HardcodedText"
                        xmlns:tools="http://schemas.android.com/tools" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s3"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
