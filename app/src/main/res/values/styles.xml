<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type: Inter in three weights, like desktop, sized for phones. -->
    <style name="TextAppearance.Segno" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="TextAppearance.Segno.Body" />
    <style name="TextAppearance.Segno.BodyStrong">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>
    <style name="TextAppearance.Segno.Small">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_2</item>
    </style>
    <style name="TextAppearance.Segno.SmallStrong">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_sm</item>
    </style>
    <style name="TextAppearance.Segno.Caption">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_3</item>
    </style>
    <style name="TextAppearance.Segno.H2">
        <item name="android:fontFamily">@font/inter_display_bold</item>
        <item name="fontFamily">@font/inter_display_bold</item>
        <item name="android:textSize">@dimen/text_h2</item>
    </style>
    <style name="TextAppearance.Segno.H1">
        <item name="android:fontFamily">@font/inter_display_bold</item>
        <item name="fontFamily">@font/inter_display_bold</item>
        <item name="android:textSize">@dimen/text_h1</item>
    </style>
    <style name="TextAppearance.Segno.Title">
        <item name="android:fontFamily">@font/inter_display_bold</item>
        <item name="fontFamily">@font/inter_display_bold</item>
        <item name="android:textSize">@dimen/text_np_title</item>
    </style>

    <!-- Plain text: start-aligned in the layout's direction, while Arabic and Hebrew titles
         still read right to left. -->
    <style name="Widget.Segno.TextView" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Segno.Body</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textDirection">firstStrong</item>
    </style>

    <style name="Widget.Segno.Line" parent="Widget.Segno.TextView">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Segno.Line.Title">
        <item name="android:textAppearance">@style/TextAppearance.Segno.Body</item>
    </style>
    <style name="Widget.Segno.Line.Sub">
        <item name="android:textAppearance">@style/TextAppearance.Segno.Small</item>
    </style>

    <style name="Widget.Segno.Heading" parent="Widget.Segno.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Segno.H1</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.Segno.Section" parent="Widget.Segno.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Segno.H2</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">@dimen/pad_x</item>
        <item name="android:paddingEnd">@dimen/pad_x</item>
        <item name="android:paddingTop">@dimen/s6</item>
        <item name="android:paddingBottom">@dimen/s2</item>
    </style>

    <!-- A 48dp icon button. -->
    <style name="Widget.Segno.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="tint">@color/text_2</item>
    </style>

    <!-- Pills, like desktop's buttons. -->
    <style name="Widget.Segno.Pill" parent="">
        <item name="android:textAlignment">center</item>
        <item name="android:layout_height">@dimen/pill_h</item>
        <item name="android:minWidth">@dimen/touch</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/s4</item>
        <item name="android:paddingEnd">@dimen/s4</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.BodyStrong</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">@dimen/s2</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Segno.Pill.Primary">
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="drawableTint">@color/on_accent</item>
    </style>
    <style name="Widget.Segno.Pill.Secondary">
        <item name="android:background">@drawable/bg_pill_secondary</item>
        <item name="android:textColor">@color/text</item>
        <item name="drawableTint">@color/text</item>
    </style>
    <style name="Widget.Segno.Pill.Ghost">
        <item name="android:background">@drawable/bg_pill_ghost</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="drawableTint">@color/text_2</item>
    </style>
    <!-- The lyrics fixes (Earlier, Later, Wrong lyrics?): small, so they fit on a 360 dp phone. -->
    <style name="Widget.Segno.Pill.Ghost.Small">
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">@dimen/s2</item>
        <item name="android:paddingEnd">@dimen/s2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_lyric_line</item>
    </style>

    <!-- Filter chips (Songs / Videos, Playlists / Songs / Albums / Artists). -->
    <style name="Widget.Segno.Chip" parent="">
        <item name="android:textAlignment">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.SmallStrong</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Segno.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/s4</item>
    </style>

    <style name="ShapeAppearance.Segno.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_sm</item>
    </style>
    <style name="ShapeAppearance.Segno.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_md</item>
    </style>
    <style name="ShapeAppearance.Segno.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_lg</item>
    </style>
    <style name="ShapeAppearance.Segno.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Segno.Seek" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">@dimen/s2</item>
        <item name="android:paddingEnd">@dimen/s2</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Bottom tabs -->
    <style name="Widget.Segno.Tab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/tabbar_h</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Segno.TabIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/tab_icon</item>
    </style>
    <style name="Widget.Segno.TabLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.SmallStrong</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Widget.Segno.SleepChip" parent="">
        <item name="android:textAlignment">center</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip_raised</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.BodyStrong</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Segno.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/s3</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/s4</item>
    </style>
    <style name="Widget.Segno.SettingsTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/s2</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.BodyStrong</item>
    </style>
    <style name="Widget.Segno.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Segno.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/s3</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/transparent</item>
    </style>
    <!-- Home's shortcut tiles: icon square on the left, name on the right. -->
    <style name="Widget.Segno.TileRow" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginStart">@dimen/s1</item>
        <item name="android:layout_marginEnd">@dimen/s1</item>
        <item name="android:background">@drawable/bg_card_clickable</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">@dimen/s2</item>
        <item name="android:paddingEnd">@dimen/s2</item>
        <item name="android:paddingTop">@dimen/s2</item>
        <item name="android:paddingBottom">@dimen/s2</item>
        <item name="android:drawablePadding">@dimen/s3</item>
        <item name="android:textAppearance">@style/TextAppearance.Segno.SmallStrong</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
